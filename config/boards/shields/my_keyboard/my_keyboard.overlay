#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <5>;

        /* 全30キーのアドレスマッピング */
        map = <
            RC(0,0) RC(0,1) RC(0,2)   RC(5,0) RC(5,1) RC(5,2)
            RC(1,0) RC(1,1) RC(1,2)   RC(6,0) RC(6,1) RC(6,2)
            RC(2,0) RC(2,1) RC(2,2)   RC(7,0) RC(7,1) RC(7,2)
            RC(3,0) RC(3,1) RC(3,2)   RC(8,0) RC(8,1) RC(8,2)
            RC(4,0) RC(4,1) RC(4,2)   RC(9,0) RC(9,1) RC(9,2)
        >;
    };

    /* 順方向と逆方向の2つのマトリクスを束ねる設定 */
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <10>;
        columns = <3>;

        /* 前半15キー (col2row) */
        matrix_col2row {
            kscan = <&kscan_col2row>;
        };

        /* 後半15キー (row2col) */
        matrix_row2col {
            kscan = <&kscan_row2col>;
            row-offset = <5>;
        };
    };

    /* 1. 前半15キー用マトリクス (Col -> Row) */
    kscan_col2row: kscan_col2row {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios = <&xiao_d 9 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 7 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 6 GPIO_ACTIVE_HIGH>;
    };

    /* 2. 後半15キー用マトリクス (Row -> Col) */
    kscan_row2col: kscan_row2col {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";

        row-gpios = <&xiao_d 0 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 1 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 2 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 3 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 10 GPIO_ACTIVE_HIGH>;

        col-gpios = <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };
};
