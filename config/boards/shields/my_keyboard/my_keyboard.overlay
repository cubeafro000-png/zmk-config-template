#include <dt-bindings/zmk/matrix_transform.h>

/* D7/D6ピンのUART機能を解除 */
&uart0 {
    status = "disabled";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2)   RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2)   RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2)   RC(2,3) RC(2,4) RC(2,5)
            RC(3,0) RC(3,1) RC(3,2)   RC(3,3) RC(3,4) RC(3,5)
            RC(4,0) RC(4,1) RC(4,2)   RC(4,3) RC(4,4) RC(4,5)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-duplex";

        /* row0:D0, row1:D1, row2:D2, row3:D3, row4:D6 */
        row-gpios = <&xiao_d 0 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 1 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 2 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 3 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 6 GPIO_ACTIVE_HIGH>;

        /* col0:D10, col1:D9, col2:D7 */
        col-gpios = <&xiao_d 10 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 9 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 7 GPIO_ACTIVE_HIGH>;
    };
};
