#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* Layer 0 (デフォルトベース - LED2: 消灯) */
        default_layer {
            bindings = <
                &kp T     &kp M    &kp J    &kp I    &kp N    &trans
                &kp TAB   &kp D    &kp E    &kp R    &kp Y    &trans
                &kp CAPS  &kp A    &kp S    &kp G    &kp F    &trans
                &kp LSHFT &kp Z    &kp X    &kp B    &kp V    &trans
                &kp LCTRL &kp LWIN &mo 3    &mo 5    &kp LALT &mo 4
            >;
        };

        /* Layer 1 (ベース2 - LED2: 赤点灯) */
        layer_1 {
            bindings = <
                &kp ESC   &kp TAB  &kp G    &kp B    &kp G    &trans
                &kp ENTER &kp D    &kp W    &kp U    &kp E    &trans
                &kp CAPS  &kp A    &kp S    &kp P    &kp K    &trans
                &kp LSHFT &kp Z    &kp V    &kp C    &kp X    &trans
                &kp LCTRL &kp LWIN &mo 3    &kp A    &kp SPACE &kp LALT
            >;
        };

        /* Layer 2 (ベース3 - LED2: 緑点灯) */
        layer_2 {
            bindings = <
                &kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5
                &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp CAPS  &kp A    &kp S    &kp D    &kp F    &kp G
                &kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B
                &kp LCTRL &kp LWIN &mo 3    &kp LALT &kp SPACE &kp SPACE
            >;
        };

        /* Layer 3 (FNレイヤー - LED2: 青点灯) */
        fn_layer {
            bindings = <
                &bt BT_CLR_ALL    &to 0    &to 1    &to 2    &trans   &trans
                &bt BT_CLR    &out OUT_TOG   &out OUT_USB   &out OUT_BLE   &trans   &trans
                &trans    &trans   &trans   &trans   &trans   &trans
                &trans    &trans   &trans   &trans   &trans   &trans
                &trans    &trans   &trans   &trans   &trans   &trans
            >;
        };

        /* Layer 4 (LED2: 黄点灯) */
        layer_4 {
            bindings = <
                &kp ESC   &kp LA(H) &kp H   &kp F    &kp G    &trans
                &kp K     &kp Q    &kp W    &kp P    &kp Y    &trans
                &kp CAPS  &kp DOT  &kp LS(O) &kp O   &kp F    &trans
                &kp LSHFT &kp COMMA &kp LC(LS(TAB)) &kp LS(TAB) &trans &trans
                &kp LCTRL &kp LWIN &mo 3    &kp LALT &kp SPACE &trans
            >;
        };

        /* Layer 5 (LED2: 紫点灯) */
        layer_5 {
            bindings = <
                &trans    &trans   &trans   &trans   &trans   &trans
                &trans    &trans   &kp KP_N7 &trans  &trans   &trans
                &trans    &kp KP_N1 &kp KP_N9 &kp KP_N3 &trans &trans
                &kp LSHFT &trans   &trans   &trans   &trans   &trans
                &kp LCTRL &kp LWIN &mo 3    &trans   &kp LALT &trans
            >;
        };
    };
};
